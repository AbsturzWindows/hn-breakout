# Copy to .env for local runs. Placeholders only, never real secrets.
# Where the Parquet tables live: a local folder (default) or a bucket, e.g. gs://<bucket>/v1
STORAGE_ROOT=./data
# MLflow on DagsHub, for hn-train (in GitHub: a variable and two secrets)
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub user>
MLFLOW_TRACKING_PASSWORD=<dagshub token>
